{
  "expo": {
    "name": "anvil",
    "slug": "anvil",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/yeti/android-icon-background.png",
    "scheme": "anvil",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/yeti/android-icon-background.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#c0cef5",
        "foregroundImage": "./assets/yeti/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.clement10.anvil"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/yeti/android-icon-background.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/with-short-cmake-paths",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#c0cef5",
          "image": "./assets/yeti/android-icon-background.png",
          "dark": {
            "image": "./assets/yeti/android-icon-background.png",
            "backgroundColor": "#c0cef5"
          },
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
